PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/dignitylink
JWT_SECRET=replace_with_a_strong_random_secret_key
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Cron schedule (default: 08:00 AM UTC daily)
SCHEDULER_CRON=0 8 * * *
ENABLE_CRON=true

# Swappable provider configuration (mock for hackathon prototype)
# Future values: africastalking | twilio | whatsapp_cloud
SMS_PROVIDER=mock-sms
WHATSAPP_PROVIDER=mock-whatsapp

# Future production provider credentials (unused in mock mode)
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
